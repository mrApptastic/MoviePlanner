@page "/"

<PageTitle>Movie Club - Home</PageTitle>

<h1>🎬 Your Movie Club</h1>

<div class="row mt-4">
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">🎥 Movies</h5>
                <p class="card-text">Search for movies and add them to your favorites.</p>
                <a href="movies" class="btn btn-primary">Browse Movies</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">👥 Friends & Groups</h5>
                <p class="card-text">Manage your friends and create groups for movie nights.</p>
                <a href="friends" class="btn btn-primary">Manage Friends</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">📍 Locations</h5>
                <p class="card-text">Add locations for your movie events.</p>
                <a href="locations" class="btn btn-primary">Manage Locations</a>
            </div>
        </div>
    </div>
</div>
<div class="row mt-2">
    <div class="col-md-6 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">📅 Events</h5>
                <p class="card-text">Schedule movie events and invite your friends.</p>
                <a href="events" class="btn btn-primary">Schedule Events</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">⚙️ Settings</h5>
                <p class="card-text">Configure your OMDb API key and spreadsheet.</p>
                <a href="settings" class="btn btn-secondary">Settings</a>
            </div>
        </div>
    </div>
</div>

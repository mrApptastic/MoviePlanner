@inherits LayoutComponentBase
@inject IGoogleAuthService AuthService

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            @if (_isAuthenticated)
            {
                <span class="me-3">Welcome, @_userName!</span>
                <button class="btn btn-outline-light btn-sm" @onclick="LogoutAsync">Logout</button>
            }
            else
            {
                <button class="btn btn-outline-light btn-sm" @onclick="LoginAsync">Sign in with Google</button>
            }
        </div>

        <article class="content px-4">
            @if (_isAuthenticated)
            {
                @Body
            }
            else
            {
                <div class="text-center mt-5">
                    <h2>🎬 Welcome to Movie Club</h2>
                    <p class="lead">Sign in with your Google account to get started!</p>
                    <button class="btn btn-primary btn-lg" @onclick="LoginAsync">
                        Sign in with Google
                    </button>
                    <p class="mt-3 text-muted">Your data is stored in your own Google Sheets.</p>
                </div>
            }
        </article>
    </main>
</div>

<div id="update-available" style="display:none" class="alert alert-info position-fixed bottom-0 end-0 m-3">
    A new version is available. <button class="btn btn-sm btn-primary" onclick="window.updateServiceWorker()">Update Now</button>
</div>

@code {
    private bool _isAuthenticated;
    private string _userName = "";

    protected override async Task OnInitializedAsync()
    {
        await CheckAuthAsync();
    }

    private async Task CheckAuthAsync()
    {
        _isAuthenticated = await AuthService.IsAuthenticatedAsync();
        if (_isAuthenticated)
        {
            var token = await AuthService.GetTokenInfoAsync();
            _userName = token?.Name ?? "User";
        }
    }

    private async Task LoginAsync()
    {
        await AuthService.LoginAsync();
        // Auth callback will update the state
    }

    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();
        _isAuthenticated = false;
        _userName = "";
        StateHasChanged();
    }
}
